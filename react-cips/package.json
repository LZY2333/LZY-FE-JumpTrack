{
  "name": "react-seed",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env MOCK_ENABLED=true vite",
    "dev:dev": "vite --mode dev",
    "dev:st": "vite --mode st",
    "dev:uat": "vite --mode uat",
    "build": "npm run build:dev",
    "build:dev": "tsc -p tsconfig.build.json && vite build --mode dev",
    "build:st": "tsc -p tsconfig.build.json && vite build --mode st",
    "build:uat": "tsc -p tsconfig.build.json && vite build --mode uat",
    "build:prd": "tsc -p tsconfig.build.json && vite build --mode prd",
    "export:src": "node scripts/export-recent-src.mjs",
    "import:src": "node scripts/import-src-txt.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@formily/antd-v5": "1.2.4",
    "@formily/core": "2.3.7",
    "@formily/react": "2.3.7",
    "ahooks": "3.8.5",
    "antd": "5.29.3",
    "axios": "1.15.0",
    "classnames": "2.3.2",
    "dayjs": "1.11.21",
    "react": "18.2.0",
    "react-activation": "^0.13.4",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.9.0",
    "react-xml-viewer": "3.0.5",
    "zustand": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^16.18.0",
    "@types/react": "18.0.27",
    "@types/react-dom": "18.0.10",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^0.34.6",
    "autoprefixer": "10.4.20",
    "cross-env": "7.0.3",
    "eslint": "8.36.0",
    "eslint-plugin-react": "7.32.2",
    "jsdom": "^21.1.0",
    "less": "4.1.3",
    "lint-staged": "13.1.2",
    "mockjs": "^1.1.0",
    "postcss": "8.4.49",
    "prettier": "2.8.4",
    "react-test-renderer": "18.2.0",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.3",
    "vite": "4.5.12",
    "vite-plugin-mock": "2.9.8",
    "vite-plugin-svgr": "4.5.0",
    "vitest": "0.32.0"
  },
  "engines": {
    "node": ">=16 <17"
  }
}
